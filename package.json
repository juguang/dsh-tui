{
  "name": "dsh-tui",
  "version": "0.1.0",
  "description": "A minimal interactive terminal UI for dsh: readline loop + streaming assistant output, zero UI dependencies.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./startup": {
      "default": "./src/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/startup.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0"
  },
  "license": "MIT"
}
