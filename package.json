{
  "name": "dsh-tui",
  "version": "0.1.0",
  "description": "An interactive terminal UI for dsh: differential-rendered chat interface with markdown, tool cards, session listing, and terminal approval.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./startup": {
      "default": "./src/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/startup.js",
    "src/markdown.js",
    "src/sessions.js",
    "src/approval.js",
    "src/theme.js",
    "src/ui.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "@earendil-works/pi-tui": "^0.84.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0"
  },
  "license": "MIT"
}
